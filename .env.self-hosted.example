# Mindris AI self-hosted release settings.
# Copy to .env in your install directory and fill provider keys as needed.

MINDRIS_VERSION=latest
MINDRIS_WEB_PORT=3000
MINDRIS_API_PORT=8000
MINDRIS_RENDERER_PORT=4000

API_KEY=dev-mindris-api-key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RENDERER_URL=http://localhost:4000

MAX_PDF_UPLOAD_BYTES=10485760
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_NUM_CTX=32768

OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
LLAMA_CLOUD_API_KEY=

SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=60000
SCRAPER_STRATEGY=auto
SCRAPER_PROXY_FALLBACK=true
SCRAPE_DO_API=
SCRAPINGBEE_API=
