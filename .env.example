# Mindris AI local development settings
API_KEY="dev-mindris-api-key"
RENDERER_URL="http://localhost:4000"
MAX_PDF_UPLOAD_BYTES="10485760"
STORAGE_DIR="./storage"
LOGS_DIR="./logs"
CHROMA_DB_DIR="./storage/vectordb"

# Public frontend values baked into the Next.js build.
# For local Docker Compose, keep localhost because the browser runs on the host.
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_RENDERER_URL="http://localhost:4000"
NEXT_PUBLIC_API_KEY="dev-mindris-api-key"

# Local Ollama defaults
OLLAMA_API_BASE="http://127.0.0.1:11434"
#OLLAMA_API_BASE="http://172.31.192.1:11434"
OLLAMA_NUM_CTX="32768"

# Cloud provider
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
MISTRAL_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
LLAMA_CLOUD_API_KEY=""

# Scraper
SCRAPER_HEADLESS="true"
SCRAPER_TIMEOUT_MS="60000"
SCRAPER_STRATEGY="auto"
SCRAPER_PROXY_FALLBACK="true"

# Optional proxy providers
SCRAPE_DO_API=""
SCRAPINGBEE_API=""
